{
  "Audit": {
    "Enabled":  true
  },
  "PublicUrl": "http://localhost:8080",
  "ReverseProxy": {
    "ForwardLimit": 1,
    "KnownAddresses": [
    ],
    "KnownNetworks": [
    ]
  },
  "Security": {
    "AllowReadDraftFiles": true,
    "JwksUri": "http://localhost:8080/jwks",
    "CorsAllowedOrigins": [
      "http://localhost:8080"
    ]
  },
  "Storage": {
    "Provider": "FileSystem",
    "FileSystem": {
      "BasePath": "/var/data"
    },
    "S3": {
      "ServiceUrl": "http://localhost:9000",
      "BucketName": "test",
      "AccessKey": "test",
      "SecretKey": "testtest",
      "ForcePathStyle": true,
      "RequestChecksumCalculationEnabled": true,
      "ResponseChecksumCalculationEnabled": true
    },
    "NextCloud": {
      "BaseUrl": "http://localhost:8090",
      "BasePath": "test",
      "TempFilePath": "tmp",
      "User": "test",
      "Password": "test",
      "ChunkedUploadThreshold": 104857600,
      "ChunkedUploadChunkSize": 10485760
    }
  },
  "System": {
    "DatasetAccessMode": "Open",
    "EnableTenancy": false
  }
}